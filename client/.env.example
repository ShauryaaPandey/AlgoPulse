# ─────────────────────────────────────────────────────────
# AlgoPulse Client — Environment Variables
# Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────────────────

# Base URL of the AlgoPulse Express API. Must NOT have a trailing slash.
# In development this points to the local Express server.
VITE_API_URL=http://localhost:3000/api
