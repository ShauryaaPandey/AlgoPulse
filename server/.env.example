# ─────────────────────────────────────────────────────────
# AlgoPulse Server — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────

# Required — used to sign/verify JWT auth cookies. Use a long random string in production.
JWT_SECRET=your-secret-key-change-in-production

# Path to the SQLite database file, relative to the server/ directory.
SQLITE_DATABASE_PATH=./data/algopulse.db

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info

# Port the Express server listens on
PORT=3000

# URL of the React client app — used for CORS allow-origin
CLIENT_URL=http://localhost:5173

# Runtime environment: development | production | test
NODE_ENV=development

# ─── MongoDB Atlas Vector Search (optional) ───────────────
# Connection string for your MongoDB Atlas cluster.
# Required for semantic search (GET /api/search) and similar-problem features.
# Create a free cluster at https://cloud.mongodb.com and enable Atlas Vector Search.
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/?retryWrites=true&w=majority

# Name of the MongoDB database to use (default: algopulse)
MONGODB_DATABASE=algopulse

# ─── Google Gemini AI (optional) ──────────────────────────
# API key for the Gemini API (used for embeddings + AI explanations).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
